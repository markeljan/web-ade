# ==============================================================================
# Web ADE — Environment Variables
# Copy to `.env.local` for local development, or run `vercel env pull .env.local`
# after linking your Vercel project (`vercel link`).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Database, Storage & Auth (Provisioned via Vercel Marketplace / Blob)
# ------------------------------------------------------------------------------

# Neon Postgres connection string (optional for local dev — falls back to local store)
DATABASE_URL=

# Vercel Blob read/write token for multimodal file & image uploads (optional locally — base64 fallback)
BLOB_READ_WRITE_TOKEN=

# Cryptographically random secret for Better Auth session signing (min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin URL for auth callbacks & WebSocket origin checks (defaults to http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AI Model Providers (5-Tier Resolution Waterfall)
#    Tier 1: Custom OpenAI-Compatible Endpoint (UI Settings or env below)
#    Tier 2: User BYOK key (UI Settings) or Sign in with Vercel OAuth token
#    Tier 3: Host Sponsor OPENAI_API_KEY (prioritized over AI Gateway key)
#    Tier 4: Host Sponsor AI_GATEWAY_API_KEY
#    Tier 5: Vercel Project OIDC (VERCEL_OIDC_TOKEN — auto-injected on Vercel)
# ------------------------------------------------------------------------------

# Host Sponsor OpenAI API key (used first for OpenAI models when no user/custom override is set)
OPENAI_API_KEY=

# Host Sponsor Vercel AI Gateway API key (vck_... — supports 500+ models across Anthropic, OpenAI, Google, xAI)
AI_GATEWAY_API_KEY=

# Optional Custom OpenAI-Compatible Endpoint (Ollama, vLLM, LM Studio, OpenRouter, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ------------------------------------------------------------------------------
# 3. Sign in with Vercel OAuth (Optional — enables user AI Gateway credit billing)
#    Create a Vercel App at: https://vercel.com/<team>/~/settings/apps
#    Callback URL: <APP_ORIGIN>/api/auth/callback/vercel
#    Scopes: openid profile email offline_access
#    Team Permissions (Private Beta): AI Gateway (Use), Team (Read Only)
# ------------------------------------------------------------------------------

VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Vercel Sandbox & Live Browser / Desktop Computer-Use (Optional)
#    Uses VERCEL_OIDC_TOKEN automatically on Vercel (or `vercel env pull` locally).
# ------------------------------------------------------------------------------

# Pre-baked @vercel/sandbox snapshot ID (from `bun run sandbox:snapshot`) for <1s boot
VERCEL_SANDBOX_SNAPSHOT_ID=

# ------------------------------------------------------------------------------
# 5. Optional Redis (Resumable Streams & Cross-Instance Pub/Sub)
#    The app degrades gracefully without Redis configured.
# ------------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 6. Remote MCP Server Authentication (Optional)
#    Secures `/api/mcp` with timing-safe `Authorization: Bearer <ADE_MCP_TOKEN>`
#    for external MCP clients (Claude Code, Cursor, fx) and private workspaces.
#    Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------

ADE_MCP_TOKEN=
